{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "nixosHost",
      "type": "pickString",
      "description": "Which NixOS host should this task target?",
      "options": ["desktop", "laptop", "generic"]
    }
  ],
  "tasks": [
    {
      "label": "Upgrade NixOS (choose host)",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/upgrade.sh\" \"${input:nixosHost}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Rebuild NixOS (choose host)",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/rebuild.sh\" \"${input:nixosHost}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    }
  ]
}
