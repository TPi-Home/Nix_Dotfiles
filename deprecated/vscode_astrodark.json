{
  "workbench.startupEditor": "none",
  "chat.agent.thinking.phrases": {
    "mode": "append",
    "phrases": []
  },
  "chat.disableAIFeatures": true,
  "workbench.colorTheme": "Visual Studio Dark - C++",
  "window.openFoldersInNewWindow": "off",

  "workbench.colorCustomizations": {
    // Canvas & Main Panels
    "editor.background": "#1A1D23",
    "editor.foreground": "#9B9FA9",
    "editor.lineHighlightBackground": "#1E222A",
    "editor.selectionBackground": "#26343F",
    "editor.findMatchBackground": "#E0E0Ee40",
    "editor.findMatchHighlightBackground": "#E0E0Ee25",
    "editorLineNumber.foreground": "#494D56",
    "editorLineNumber.activeForeground": "#ADB0BB",

    // Side Bar & Activity Bar
    "sideBar.background": "#16181D",
    "sideBar.foreground": "#9B9FA9",
    "sideBar.border": "#3A3E47",
    "activityBar.background": "#111317",
    "activityBar.foreground": "#ADB0BB",
    "activityBar.inactiveForeground": "#494D56",

    // Tabs & Editor Groups
    "editorGroupHeader.tabsBackground": "#111317",
    "tab.activeBackground": "#1A1D23",
    "tab.activeForeground": "#ADB0BB",
    "tab.inactiveBackground": "#111317",
    "tab.inactiveForeground": "#494D56",
    "tab.border": "#3A3E47",

    // Status Bar & Title Bar
    "statusBar.background": "#111317",
    "statusBar.foreground": "#ADB0BB",
    "titleBar.activeBackground": "#111317",
    "titleBar.activeForeground": "#ADB0BB",

    // Windows & UI Elements
    "editorWidget.background": "#14161B",
    "editorWidget.border": "#3A3E47",
    "input.background": "#21242A",
    "input.foreground": "#ADB0BB",
    "list.activeSelectionBackground": "#26343F",
    "list.hoverBackground": "#23272F",
    "scrollbarSlider.background": "#50A4E940",
    "scrollbarSlider.hoverBackground": "#50A4E970",
    "scrollbarSlider.activeBackground": "#50A4E9",
    "borderColor": "#3A3E47",
    
    // Terminal colors
    "terminal.background": "#1A1D23",
    "terminal.foreground": "#9B9FA9",
    "terminal.ansiBlack": "#111317",
    "terminal.ansiRed": "#FF838B",
    "terminal.ansiGreen": "#87C05F",
    "terminal.ansiYellow": "#DFAB25",
    "terminal.ansiBlue": "#5EB7FF",
    "terminal.ansiMagenta": "#DD97F1",
    "terminal.ansiCyan": "#4AC2B8",
    "terminal.ansiWhite": "#9B9FA9"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#696C76",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable",
          "variable.parameter",
          "meta.block"
        ],
        "settings": {
          "foreground": "#ADB0BB"
        }
      },
      {
        "scope": [
          "keyword",
          "storage.type",
          "storage.modifier"
        ],
        "settings": {
          "foreground": "#DD97F1"
        }
      },
      {
        "scope": [
          "string",
          "punctuation.definition.string"
        ],
        "settings": {
          "foreground": "#87C05F"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language",
          "keyword.other.unit"
        ],
        "settings": {
          "foreground": "#F5983A"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#5EB7FF"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.type",
          "support.class"
        ],
        "settings": {
          "foreground": "#DFAB25"
        }
      },
      {
        "scope": [
          "entity.name.tag",
          "keyword.control.html"
        ],
        "settings": {
          "foreground": "#FF838B"
        }
      },
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#F5983A"
        }
      },
      {
        "scope": [
          "constant.character.escape",
          "punctuation.section.embedded"
        ],
        "settings": {
          "foreground": "#4AC2B8"
        }
      }
    ]
  }
}

