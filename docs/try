# ----------------------------------------------------------------------------
# Reload / Exit
# ----------------------------------------------------------------------------

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec \
    swaynag -t logout \
    -m 'Log out of Sway?' \
    -b 'Yes, log out' 'systemctl --user stop graphical-session.target session.slice && swaymsg exit'
