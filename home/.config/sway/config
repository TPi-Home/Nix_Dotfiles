# ============================================================================
# Sway
# ============================================================================

include /etc/sway/config.d/*

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------

set $mod Mod4

input type:keyboard xkb_numlock enabled

font pango:Monaspace Neon NF 14

default_border normal 2
default_floating_border normal 2
smart_borders off
titlebar_border_thickness 0

gaps inner 0
gaps outer 0

focus_follows_mouse yes
floating_modifier $mod

# X11 Compatibility Tool: (must visit /home-manager/sway/sway.nix to change 2 other lines)
#exec_always xwayland-satellite :1

# ----------------------------------------------------------------------------
# Cursor (Should be handled by home-manager)
# ----------------------------------------------------------------------------

# seat seat0 xcursor_theme Adwaita 36

# ----------------------------------------------------------------------------
# Colors - AstroDark
# ----------------------------------------------------------------------------

# Format:               border      bg          text       indic       child_border
client.focused          #50A4E9     #50A4E9     #111317    #5EB7FF     #50A4E9
client.focused_inactive #3A3E47     #16181D     #9B9FA9    #696C76     #3A3E47
client.unfocused        #3A3E47     #16181D     #9B9FA9    #696C76     #3A3E47
client.urgent           #CC83E3     #CC83E3     #111317    #DD97F1     #CC83E3

# ----------------------------------------------------------------------------
# Applications
# -------------------------------------------------------------pixel---------------

set $term kitty
set $menu fuzzel

# ----------------------------------------------------------------------------
# Startup
# ----------------------------------------------------------------------------

exec dbus-update-activation-environment --systemd --all
exec waybar
exec kanshi
exec_always kanshictl reload
exec mako
exec udiskie
exec nm-applet
exec blueman
exec swayidle -w \
    timeout 300 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"'

# ----------------------------------------------------------------------------
# Input
# ----------------------------------------------------------------------------

input type:touchpad 
{
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:pointer {
    pointer_accel 0.7
    accel_profile flat
}

# ----------------------------------------------------------------------------
# Terminal / Launcher
# ----------------------------------------------------------------------------

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
# bindsym $mod+d exec rofi -show drun
bindsym $mod+q kill

# Press Super + Alt + A to start autotiling
bindsym $mod+a exec autotiling

# Press Super + Alt + X to kill autotiling and return to pure i3/Sway behavior
bindsym $mod+x exec pkill -f autotiling

# ----------------------------------------------------------------------------
# Notifications
# ----------------------------------------------------------------------------

bindsym Ctrl+space exec makoctl dismiss

# ----------------------------------------------------------------------------
# Screenshots
# ----------------------------------------------------------------------------

bindsym $mod+Shift+p exec grim - | swappy -f -
bindsym Shift+Print exec grim -g "$(slurp)" - | swappy -f -

# ----------------------------------------------------------------------------
# Reload / Exit
# ----------------------------------------------------------------------------

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec \
    swaynag -t logout \
    -m 'Log out of Sway?' \
    -b 'Yes, log out' 'systemctl --user stop wayland-session.scope'

# ----------------------------------------------------------------------------
# Focus
# ----------------------------------------------------------------------------

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# ----------------------------------------------------------------------------
# Move Windows
# ----------------------------------------------------------------------------

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ----------------------------------------------------------------------------
# Workspaces
# ----------------------------------------------------------------------------

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# ----------------------------------------------------------------------------
# Move Windows to Workspaces
# ----------------------------------------------------------------------------

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Tab workspace back_and_forth

# ----------------------------------------------------------------------------
# Layout
# ----------------------------------------------------------------------------

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+m layout tabbed 
bindsym $mod+e layout split
bindsym $mod+t layout toggle split
bindsym $mod+w layout stacking
bindsym $mod+f fullscreen

# ----------------------------------------------------------------------------
# Floating
# ----------------------------------------------------------------------------

# Toggle the current focus between tiling and floating mode
bindsym $mod+c floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+z focus mode_toggle

# ----------------------------------------------------------------------------
# Resize
# ----------------------------------------------------------------------------

bindsym $mod+Mod1+h resize shrink width 20px
bindsym $mod+Mod1+j resize shrink height 20px
bindsym $mod+Mod1+k resize grow height 20px
bindsym $mod+Mod1+l resize grow width 20px

# ----------------------------------------------------------------------------
# Media
# ----------------------------------------------------------------------------

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# ----------------------------------------------------------------------------
# Wallpaper
# ----------------------------------------------------------------------------

output * bg /home/tyler/Pictures/Hilltopper.png fill

