modules-left = [
  "sway/workspaces"
];

modules-center = [
  "clock"
];

modules-right = [
  "network"
  "pulseaudio"
  "battery"
  "tray"
];

network = {
  format-wifi = "";
  format-ethernet = "󰈀";
  format-disconnected = "󰤮";
