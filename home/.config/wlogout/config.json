[global]
buttons-per-row=3

[lock]
label=Lock
action=swaylock -f
text-color=#ADB0BB

[logout]
label=Logout
action=swaymsg exit
text-color=#ADB0BB

[suspend]
label=Suspend
action=systemctl suspend
text-color=#ADB0BB

[hibernate]
label=Hibernate
action=systemctl hibernate
text-color=#ADB0BB

[shutdown]
label=Shutdown
action=systemctl poweroff
text-color=#ADB0BB

[reboot]
label=Reboot
action=systemctl reboot
text-color=#ADB0BB